{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotifyTrap",
  "version": "1.5.0",
  "identifier": "dev.notifytrap.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotifyTrap",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMUNCQUMyRTgwMTA3MTEKUldRUkJ3SG93cm9jakVuejBWcm5FUGRNZURrSmlFWkh5U0ZNcVdCNDlXcXVMQ2FDajA5WVYzYnIK",
      "endpoints": [
        "https://github.com/farshidrezaei/notifytrap/releases/latest/download/latest.json"
      ]
    }
  }
}
